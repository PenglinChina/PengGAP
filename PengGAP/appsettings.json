{
  // 子配置文件 appsettings/appsettings.*.json 会被自动加载，修改后需要重启应用程序才生效
  "PengGAP": {
    "HttpProxyPort": 38457, // http代理端口，仅 Linux/macOS 使用；Windows 走 WinDivert 透明拦截

    // 兜底 DNS：仅在 dnscrypt-proxy 不可用时才会用到。
    // 程序会先用 TCP/53 探测可用性（国内到 8.8.8.8 的 TCP 通常不通），因此国内 DNS 排在前面。
    "FallbackDns": [
      "119.29.29.29:53", // DNSPod
      "114.114.114.114:53", // 114DNS
      "8.8.8.8:53" // 境外纯净源，最后兜底
    ],

    // 域名配置：
    //   键       = 域名表达式，* 匹配除 . 之外的 0~n 个字符，全匹配且忽略大小写
    //   匹配顺序 = 段数少的表达式优先；同段数时，自右向左逐段比较，字面量优先于通配符
    //
    // 可用字段（全部可选）：
    //   "TlsSni"                : 是否在 TLS 握手时发送 SNI，默认 false（不发送）
    //   "TlsSniPattern"         : SNI 表达式，@domain 取域名、@ipaddress 取实际连接 IP、@random 取随机值
    //   "TlsIgnoreNameMismatch" : 是否忽略服务器证书域名不匹配；不发 SNI 时通常需要设为 true
    //   "Timeout"               : 请求超时，格式 "00:02:00"
    //   "IPAddress"             : 强制连接指定 IP，跳过 DNS 优选
    //   "Destination"           : 改写真实目的地，绝对或相对 Uri
    //   "Response"              : 直接阻断并响应；一旦设置，其它字段全部失效
    //
    // 这里不预置任何域名规则：上游版本预置的示例规则会真实劫持该域名并返回 404，已移除。
    // 具体的域名规则见 appsettings/appsettings.*.json，如需添加按下面格式书写（去掉注释符号）：
    //
    // "example.com": {
    //   "TlsSni": false,
    //   "TlsIgnoreNameMismatch": true
    // },
    // "cdn.example.com": {
    //   "TlsSni": true,
    //   "Destination": "https://cdn.example.net/"
    // }
    "DomainConfigs": {}
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Yarp": "Warning",
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Server.Kestrel": "Error"
      }
    }
  }
}
